# Gandom Gallery — environment overview
# Copy values into backend/.env, frontend/.env, backoffice/.env
#
# Production (Liara / gandomshop.com):
#   FRONTEND_URL=https://gandomshop.com
#   PUBLIC_URL=https://api.gandomshop.com
#   VITE_API_URL=https://api.gandomshop.com
#   DIGIPAY_CALLBACK_URL=https://gandomshop.com/payment/callback

# Graphify semantic extraction (local only — never commit real keys)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias; GOOGLE_API_KEY takes precedence if both set

# Backend
GANDOM_SEED=true
OTP_DEV_CODE=11111
DIGIPAY_CALLBACK_URL=http://localhost:5173/payment/callback
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=123456
FRONTEND_URL=http://localhost:5173
BACKOFFICE_URL=http://localhost:5174
STRAPI_PLUGIN_ADVANCED_ECOMMERCE_SEED_DATA=false

# Frontend / Backoffice
VITE_API_URL=http://localhost:1337
VITE_WC_PREFIX=/api/webbycommerce
VITE_STORE_URL=http://localhost:5173
