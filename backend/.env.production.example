# Production env template for Liara (gandom-api).
# Set values with: liara env:set KEY=value -a gandom-api -f --api-token=...
# Never commit real secrets. Never put secrets in liara.json "envs".

HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Generate unique values (openssl rand -base64 32)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Liara managed Postgres (private network) — from DB "how to connect"
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
# Or use a single URL if provided:
# DATABASE_URL=

# Public API URL (media absolute links). Must be the Strapi host, NOT the storefront.
PUBLIC_URL=https://gandom-api.liara.run
DIGIPAY_CALLBACK_URL=https://gandom-web.liara.run/payment/callback
DIGIPAY_REFUND_SECRET=

# Bootstrap admins (set strong passwords; use FORCE only once then set false)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRSTNAME=Developer
SUPER_ADMIN_LASTNAME=Admin
SUPER_ADMIN_FORCE_PASSWORD=false

SHOP_OWNER_EMAIL=
SHOP_OWNER_PASSWORD=
SHOP_OWNER_FIRSTNAME=مالک
SHOP_OWNER_LASTNAME=فروشگاه
SHOP_OWNER_FORCE_PASSWORD=false

# Production: never seed / never enable dev OTP
GANDOM_SEED=false
STRAPI_PLUGIN_ADVANCED_ECOMMERCE_SEED_DATA=false
# Do NOT set OTP_DEV_CODE or ALLOW_DEV_OTP_IN_PRODUCTION

# Liara Object Storage (S3-compatible) — from bucket SDK settings
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_REGION=default
AWS_S3_FORCE_PATH_STYLE=true
CDN_URL=
