HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (docker compose overrides these)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Gandom
GANDOM_SEED=true
OTP_DEV_CODE=11111
DIGIPAY_CALLBACK_URL=http://localhost:5173/payment/callback
FRONTEND_URL=http://localhost:5173
# Deprecated custom backoffice — use Strapi Admin at /admin
# BACKOFFICE_URL=http://localhost:5174

# Developer Super Admin (production) — set in real .env, never commit secrets
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRSTNAME=Developer
SUPER_ADMIN_LASTNAME=Admin
# Set true once to reset password on boot, then set back to false
SUPER_ADMIN_FORCE_PASSWORD=false

# Shop Owner admin (restricted role)
SHOP_OWNER_EMAIL=owner@gandom.local
SHOP_OWNER_PASSWORD=GandomOwner123!
SHOP_OWNER_FIRSTNAME=مالک
SHOP_OWNER_LASTNAME=فروشگاه
SHOP_OWNER_FORCE_PASSWORD=false

# Shared secret for Digipay refund API (header x-refund-secret)
DIGIPAY_REFUND_SECRET=change-me-long-random

# Emergency only — never enable in production under normal ops
# ALLOW_DEV_OTP_IN_PRODUCTION=false

# Do not seed WebbyCommerce English demo
STRAPI_PLUGIN_ADVANCED_ECOMMERCE_SEED_DATA=false
